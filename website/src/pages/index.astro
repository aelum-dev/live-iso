---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body>
    <main class="container">
      <h1>Astro</h1>
      <p>
        Welcome to <a href="https://astro.build" target="_blank">Astro</a>. This
        project is bootstrapped with the minimal template. Get started by editing
        <code>src/pages/index.astro</code>.
      </p>
      <div class="grid">
        <a class="card" href="https://docs.astro.build">
          <h2>Documentation</h2>
          <p>
            Where do I go from here? Look through the Astro
            <a href="https://docs.astro.build/docs" target="_blank">documentation</a>
            to learn more.
          </p>
        </a>
        <a class="card" href="https://astro.build/examples" target="_blank">
          <h2>Examples</h2>
          <p>
            Want to get a head start? Look through a list of
            <a href="https://astro.build/examples" target="_blank">example sites</a>
            for inspiration.
          </p>
        </a>
      </div>
    </main>
  </body>
</html>
