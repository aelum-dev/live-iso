{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "$HOME/.config/fastfetch/logo.png",
        "width": 36,
        "height": 16,
        "padding": {
            "top": 2
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
        },
        "break",
        {
            "key": "{icon} OS           ",
            "keyColor": "red",
            "type": "os"
        },
        {
            "key": "{icon} Kernel       ",
            "keyColor": "yellow",
            "type": "kernel"
        },
        {
            "key": "{icon} Packages     ",
            "type": "packages",
            "keyColor": "blue"
        },
        {
            "key": "{icon} Machine      ",
            "keyColor": "green",
            "type": "host"
        },
        {
            "key": "{icon} Uptime       ",
            "keyColor": "red",
            "type": "uptime"
        },
        {
            "key": "{icon} OS Age       ",
            "type": "disk",
            "keyColor": "green",
            "folders": "/",
            "format": "{days} days"
        },
        {
            "key": "{icon} Resolution   ",
            "keyColor": "yellow",
            "type": "display",
            "compactType": "original-with-refresh-rate"
        },
        {
            "key": "{icon} WM           ",
            "keyColor": "blue",
            "type": "wm"
        },
        {
            "key": "{icon} DE           ",
            "keyColor": "green",
            "type": "de"
        },
        {
            "key": "{icon} Shell        ",
            "keyColor": "cyan",
            "type": "shell"
        },
        {
            "key": "{icon} Terminal     ",
            "keyColor": "red",
            "type": "terminal"
        },
        {
            "key": "{icon} CPU          ",
            "keyColor": "yellow",
            "type": "cpu"
        },
        {
            "key": "{icon} GPU          ",
            "keyColor": "blue",
            "type": "gpu"
        },
        {
            "key": "{icon} Memory       ",
            "keyColor": "yellow",
            "type": "memory"
        },
        {
            "key": "{icon} Disk         ",
            "type": "disk",
            "keyColor": "green"
        },
        {
            "key": "{icon} Local IP     ",
            "keyColor": "red",
            "type": "localip",
            "compact": true
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 15,
            "symbol": "circle"
        }
    ]
}
