#
# Start the Fcitx5 input method framework in every desktop session.
#
# This unit ships in the live ISO and the installer copies it into the installed
# system (install/isocopy). It is system-side (/etc/systemd/user, a load path of
# every user manager) so every account runs it, but it is pulled in per-home: the
# wants link seeded into ~/.config/systemd/user/hyprland-session.target.wants/ by
# /etc/skel - the same mechanism that starts dms.service and the snapshot-restore
# prompt - starts it in real user sessions only. The greeter runs a Hyprland
# session too and has no seeded home, so it is not asked.
#
# The ConditionPathExists gate is what keeps the live session out of this: the
# live image carries the unit (it is the source the installer copies) but not
# fcitx5 itself, and the gate fails on its own there - the same shape that keeps
# the snapshot prompt inert in the live session, with no per-home mask needed.
#
# The client half of the wiring is in the seeded Hyprland config: QT_IM_MODULE and
# XMODIFIERS are set there, and the session's dbus-update-activation-environment
# call propagates them. The input methods themselves are configured rather than
# discovered: the installer writes /etc/xdg/fcitx5/profile (language engine +
# location keyboard layout, English first) and ships /etc/xdg/fcitx5/config, which
# puts the switch on Alt+Shift. Both are read from the system config directory
# until a person changes anything and the framework saves its own copy in the home.

[Unit]
Description=Aelum: Fcitx5 input method framework
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionPathExists=/usr/bin/fcitx5

[Service]
Type=simple
ExecStart=/usr/bin/fcitx5
# always, not on-failure: the tray's "Restart" is exit(0) plus a forked
# `fcitx5 -r` replacement (src/server/main.cpp), and the unit's own stop kills
# that child with the cgroup - on-failure never sees a failure there and the
# session is simply left without an input method. The same clean exit 0 happens
# when another instance already owns org.fcitx.Fcitx5 (a D-Bus-activated stray,
# e.g. opened by fcitx5-configtool): kill the stray before restarting the unit,
# or the respawned instance exits on arrival and this becomes a restart loop.
# Tray "Exit" respawns under this rule as well - the framework is a permanent
# part of the session, like the shell units beside it.
Restart=always
RestartSec=1

[Install]
WantedBy=hyprland-session.target
