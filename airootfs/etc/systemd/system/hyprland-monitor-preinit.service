[Unit]
Description=Auto-generate Hyprland monitor configuration
Documentation=https://wiki.hypr.land/Configuring/Basics/Monitors/
Before=greetd.service
After=systemd-udevd.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/generate-hyprland-monitor-config.sh
RemainAfterExit=yes

# Run as root but set HOME for the aestheticos user
Environment=HOME=/home/aestheticos

[Install]
WantedBy=multi-user.target
