# Aelum Plymouth theme - LUKS / dm-crypt unlock splash
#
# Runs on the C "script" engine (script.so) shipped in Arch's plymouth.
# Arch's plymouth does NOT include a Lua plugin, so a .lua theme would fail
# to load here; this is the only scripting engine available.

# Dark mauve-tinted background (matches Aelum branding, hides firmware flash)
Window.SetBackgroundTopColor(0.071, 0.055, 0.063);
Window.SetBackgroundBottomColor(0.043, 0.035, 0.039);

#----------------------------------------- Assets --------------------------------

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetOpacity(0.95);

lock.image = Image("lock.png");
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

progress_box.image = Image("progress_box.png");
progress_bar.original = Image("progress_bar.png");

#----------------------------------------- State --------------------------------

global.password_shown = 0;
# animation_frame MUST be global: the script engine treats any name that is
# never declared at the top level as LOCAL to the function that first uses it.
# refresh_callback runs in a fresh scope every frame, so an undeclared
# animation_frame resets to 0 each call and the fake progress bar never moves.
global.animation_frame = 0;
global.fake_progress_active = 0;
global.fake_progress = 0.0;
global.fake_progress_limit = 0.6;      # fake bar target while unlocking
global.fake_progress_duration = 12.0;  # seconds to reach it
global.fake_progress_start = 0.0;      # duration when real progress unfreezes
global.max_progress = 0.0;             # prevent progress bar moving backwards
global.layout_w = 0;
global.layout_h = 0;
global.bullets = [];

progress_bar.image = progress_bar.original.Scale(1, progress_bar.original.GetHeight());
progress_bar.sprite = Sprite(progress_bar.image);
progress_bar.sprite.SetOpacity(0);

#----------------------------------------- Refresh / animation --------------------------------

fun refresh_callback()
{
  # Re-center everything if a display appears late (e.g. Thunderbolt DP)
  if (Window.GetWidth() != global.layout_w || Window.GetHeight() != global.layout_h)
  {
    layout();
  }

  # Animate the fake progress bar (eases toward the limit) while unlocking
  if (global.fake_progress_active == 1)
  {
    global.animation_frame++;
    elapsed_time = global.animation_frame / 50.0;   # 50 FPS
    time_ratio = elapsed_time / global.fake_progress_duration;
    if (time_ratio > 1.0) time_ratio = 1.0;
    eased_ratio = 1 - ((1 - time_ratio) * (1 - time_ratio));   # ease-out quad
    global.fake_progress = eased_ratio * global.fake_progress_limit;
    update_progress_bar(global.fake_progress);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

fun update_progress_bar(progress)
{
  if (progress > global.max_progress)
  {
    global.max_progress = progress;
    width = Math.Int(progress_bar.original.GetWidth() * progress);
    if (width < 1) width = 1;
    progress_bar.image = progress_bar.original.Scale(width, progress_bar.original.GetHeight());
    progress_bar.sprite.SetImage(progress_bar.image);
  }
}

fun show_progress_bar()
{
  progress_box.sprite.SetOpacity(1);
  progress_bar.sprite.SetOpacity(1);
}

fun hide_progress_bar()
{
  progress_box.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);
}

fun start_fake_progress()
{
  global.fake_progress_active = 1;
  animation_frame = 0;
  global.max_progress = 0.0;
  global.fake_progress = 0.0;
  global.fake_progress_start = 0.0;
}

fun stop_fake_progress()
{
  global.fake_progress_active = 0;
}

#----------------------------------------- Dialogue --------------------------------

lock.sprite = Sprite(lock.image);
lock.sprite.SetOpacity(0);
entry.sprite = Sprite(entry.image);
entry.sprite.SetOpacity(0);
progress_box.sprite = Sprite(progress_box.image);
progress_box.sprite.SetOpacity(0);

fun show_password_dialog()
{
  lock.sprite.SetOpacity(1);
  entry.sprite.SetOpacity(1);
}

fun hide_password_dialog()
{
  lock.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);
  for (index = 0; global.bullets[index]; index++)
  {
    global.bullets[index].SetOpacity(0);
  }
}

fun position_bullet(index)
{
  global.bullets[index].SetPosition(entry.x + 16 + index * 14,
                                    entry.y + entry.image.GetHeight() / 2 - 4.5,
                                    10002);
}

fun display_normal_callback()
{
  hide_password_dialog();
  # Show the progress bar for any boot/resume. During a LUKS unlock the real
  # progress is frozen, so the fake bar (driven in refresh_callback) keeps it
  # moving; progress_callback hands off to real progress once it unfreezes.
  mode = Plymouth.GetMode();
  if ((mode == "boot" || mode == "resume") && !global.password_shown)
  {
    show_progress_bar();
    # Start the fake bar only once; display_normal is called repeatedly.
    if (!global.fake_progress_active)
    {
      start_fake_progress();
    }
  }
}

fun display_password_callback(prompt, bullets)
{
  global.password_shown = 1;
  show_password_dialog();
  # Keep the progress bar visible and animating while the drive decrypts
  # (real progress is frozen during unlock). Restart the fake bar if needed.
  show_progress_bar();
  if (!global.fake_progress_active)
  {
    start_fake_progress();
  }

  # Clear old bullets
  for (index = 0; global.bullets[index]; index++)
  {
    global.bullets[index].SetOpacity(0);
  }

  # Draw masked-password dots (max 24)
  max_bullets = 24;
  bullets_to_show = bullets;
  if (bullets_to_show > max_bullets)
  {
    bullets_to_show = max_bullets;
  }
  for (index = 0; index < bullets_to_show; index++)
  {
    if (!global.bullets[index])
    {
      global.bullets[index] = Sprite(bullet.image.Scale(9, 9));
      position_bullet(index);
    }
    global.bullets[index].SetOpacity(1);
  }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

#----------------------------------------- Progress Bar --------------------------------

progress_bar.sprite.SetOpacity(0);

fun progress_callback(duration, progress)
{
  # duration/progress freeze while the drive is decrypting; capture the
  # moment they unfreeze so we can hand off from the fake bar to real progress
  if (global.fake_progress_start == 0.0)
  {
    global.fake_progress_start = duration;
  }
  if (duration > global.fake_progress_start && progress > global.fake_progress)
  {
    stop_fake_progress();
    update_progress_bar(progress);
  }
}

Plymouth.SetBootProgressFunction(progress_callback);

#----------------------------------------- Message --------------------------------

message_sprite = Sprite();
# Bottom-center, above the progress bar (z=1) but below the entry field (z=10001)
message_sprite.SetPosition(0, 0, 2);

fun display_message_callback(text)
{
  # Image.Text(text, red, green, blue) -> white text (alpha/font/align default)
  message_sprite.SetImage(Image.Text(text, 1, 1, 1));
  message_sprite.SetOpacity(0.9);
  # Keep the text horizontally centered and pinned to the bottom, on-screen
  tw = message_sprite.GetImage().GetWidth();
  th = message_sprite.GetImage().GetHeight();
  w = Window.GetWidth();
  message_sprite.SetX((w - tw) / 2);
  message_sprite.SetY(Window.GetHeight() - th - 12);
}

fun hide_message_callback(text)
{
  message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

#----------------------------------------- Layout --------------------------------

fun layout()
{
  global.layout_w = Window.GetWidth();
  global.layout_h = Window.GetHeight();

  # Scale logo to a fixed height, preserve aspect ratio
  logo_h = 200;
  logo_w = Math.Int(logo.image.GetWidth() * (logo_h / logo.image.GetHeight()));
  logo.image = logo.image.Scale(logo_w, logo_h);
  logo.sprite.SetImage(logo.image);

  logo.sprite.SetX(global.layout_w / 2 - logo.image.GetWidth() / 2);
  logo.sprite.SetY(global.layout_h / 2 - logo.image.GetHeight() / 2 - 24);

  # Entry field sits below the logo
  entry.x = global.layout_w / 2 - entry.image.GetWidth() / 2;
  entry.y = logo.sprite.GetY() + logo.image.GetHeight() + 48;
  entry.sprite.SetPosition(entry.x, entry.y, 10001);

  # Lock icon sits just left of the entry field, vertically centered on it
  scale = entry.image.GetHeight() / lock.image.GetHeight();
  lock.w = lock.image.GetWidth() * scale;
  lock.h = lock.image.GetHeight() * scale;
  lock.sprite.SetImage(lock.image.Scale(lock.w, lock.h));
  lock.sprite.SetX(entry.x - lock.w - 14);
  lock.sprite.SetY(entry.y + entry.image.GetHeight() / 2 - lock.h / 2);

  # Progress bar below the entry
  box_x = global.layout_w / 2 - progress_box.image.GetWidth() / 2;
  box_y = entry.y + entry.image.GetHeight() + 40;
  progress_box.sprite.SetPosition(box_x, box_y, 0);
  progress_bar.sprite.SetPosition(global.layout_w / 2 - progress_bar.original.GetWidth() / 2,
                                  box_y + (progress_box.image.GetHeight() - progress_bar.original.GetHeight()) / 2,
                                  1);
}

layout();
