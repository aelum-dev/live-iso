# Aelum Plymouth theme - LUKS / dm-crypt unlock splash
# Runs on the C "script" engine (script.so)

# Dark mauve-tinted background
Window.SetBackgroundTopColor(0.071, 0.055, 0.063);
Window.SetBackgroundBottomColor(0.043, 0.035, 0.039);

#----------------------------------------- Assets --------------------------------

logo.original = Image("logo.png");
logo.image = logo.original;
logo.sprite = Sprite(logo.image);
logo.sprite.SetOpacity(0.95);

lock.image = Image("lock.png");
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

progress_box.image = Image("progress_box.png");
progress_bar.original = Image("progress_bar.png");

#----------------------------------------- State --------------------------------

global.password_shown = 0;
global.animation_frame = 0;
global.fake_progress_active = 0;
global.max_progress = 0.0;
global.layout_w = 0;
global.layout_h = 0;
global.bullets = [];

# Seconds from hitting Enter on LUKS to reaching the greeter.
# Tweak between 1.5 and 2.5 depending on your hardware speed.
global.post_unlock_duration = 2.0;
# Seconds for a cold boot (no LUKS prompt seen yet).
global.cold_boot_duration = 7.0;

progress_bar.image = progress_bar.original.Scale(1, progress_bar.original.GetHeight());
progress_bar.sprite = Sprite(progress_bar.image);
progress_bar.sprite.SetOpacity(0);

progress_box.sprite = Sprite(progress_box.image);
progress_box.sprite.SetOpacity(0);

lock.sprite = Sprite(lock.image);
lock.sprite.SetOpacity(0);

entry.sprite = Sprite(entry.image);
entry.sprite.SetOpacity(0);

#----------------------------------------- Helpers --------------------------------

fun position_bullet(index)
{
  global.bullets[index].SetPosition(entry.x + 16 + index * 14,
                                    entry.y + entry.image.GetHeight() / 2 - 4.5,
                                    10002);
}

# Monotonic: the bar only ever moves forward, so fake and real progress
# can both feed it and whichever is ahead wins.
fun update_progress_bar(progress)
{
  if (progress > global.max_progress)
  {
    global.max_progress = progress;
    width = Math.Int(progress_bar.original.GetWidth() * progress);
    if (width < 1) width = 1;
    progress_bar.image = progress_bar.original.Scale(width, progress_bar.original.GetHeight());
    progress_bar.sprite.SetImage(progress_bar.image);
  }
}

fun show_progress_bar()
{
  progress_box.sprite.SetOpacity(1);
  progress_bar.sprite.SetOpacity(1);
}

fun hide_progress_bar()
{
  progress_box.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);
}

# Restarts the fake timer only. max_progress is kept, so the bar never
# snaps back to zero and real progress can't cause a jump after unlock.
fun start_fake_progress()
{
  global.fake_progress_active = 1;
  global.animation_frame = 0;
}

fun stop_fake_progress()
{
  global.fake_progress_active = 0;
}

#----------------------------------------- Layout --------------------------------

fun layout()
{
  global.layout_w = Window.GetWidth();
  global.layout_h = Window.GetHeight();

  # Scale logo from the pristine original every time
  logo_h = 200;
  logo_w = Math.Int(logo.original.GetWidth() * (logo_h / logo.original.GetHeight()));
  logo.image = logo.original.Scale(logo_w, logo_h);
  logo.sprite.SetImage(logo.image);

  logo.sprite.SetX(global.layout_w / 2 - logo.image.GetWidth() / 2);
  logo.sprite.SetY(global.layout_h / 2 - logo.image.GetHeight() / 2 - 24);

  # Entry field
  entry.x = global.layout_w / 2 - entry.image.GetWidth() / 2;
  entry.y = logo.sprite.GetY() + logo.image.GetHeight() + 48;
  entry.sprite.SetPosition(entry.x, entry.y, 10001);

  # Lock icon
  scale = entry.image.GetHeight() / lock.image.GetHeight();
  lock.w = Math.Int(lock.image.GetWidth() * scale);
  lock.h = Math.Int(lock.image.GetHeight() * scale);
  lock.sprite.SetImage(lock.image.Scale(lock.w, lock.h));
  lock.sprite.SetX(entry.x - lock.w - 14);
  lock.sprite.SetY(entry.y + entry.image.GetHeight() / 2 - lock.h / 2);

  # Progress bar
  box_x = global.layout_w / 2 - progress_box.image.GetWidth() / 2;
  box_y = entry.y + entry.image.GetHeight() + 40;
  progress_box.sprite.SetPosition(box_x, box_y, 0);
  progress_bar.sprite.SetPosition(global.layout_w / 2 - progress_bar.original.GetWidth() / 2,
                                  box_y + (progress_box.image.GetHeight() - progress_bar.original.GetHeight()) / 2,
                                  1);

  # Reposition any existing bullets after a resolution change
  for (index = 0; global.bullets[index]; index++)
  {
    position_bullet(index);
  }
}

#----------------------------------------- Refresh / Animation --------------------------------

fun refresh_callback()
{
  # Re-center if display layout updates late
  if (Window.GetWidth() != global.layout_w || Window.GetHeight() != global.layout_h)
  {
    layout();
  }

  if (global.fake_progress_active == 1)
  {
    global.animation_frame++;
    elapsed_time = global.animation_frame / 50.0;   # plymouthd refreshes at ~50 FPS

    # Post-LUKS boot only takes ~1.5 - 2.5s; cold boot takes ~7s.
    if (global.password_shown == 1)
    {
      target_time = global.post_unlock_duration;
    }
    else
    {
      target_time = global.cold_boot_duration;
    }

    # Single smooth curve: p = 0.98 * x / (x + 0.15), x = elapsed / target.
    # Reaches ~85% at target_time, then keeps creeping toward 98% without
    # ever hitting it. Velocity is continuous, so there is no lurch.
    x = elapsed_time / target_time;
    update_progress_bar(0.98 * x / (x + 0.15));
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

#----------------------------------------- Dialogue & Hooks --------------------------------

fun show_password_dialog()
{
  lock.sprite.SetOpacity(1);
  entry.sprite.SetOpacity(1);
}

fun hide_password_dialog()
{
  lock.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);
  for (index = 0; global.bullets[index]; index++)
  {
    global.bullets[index].SetOpacity(0);
  }
}

# Called when boot begins (no LUKS) OR after password unlock succeeds
fun display_normal_callback()
{
  hide_password_dialog();

  mode = Plymouth.GetMode();
  if (mode == "boot" || mode == "resume" || mode == "updates" || mode == "system-upgrade")
  {
    show_progress_bar();
    if (!global.fake_progress_active)
    {
      start_fake_progress();
    }
  }
}

# Called when LUKS prompts for password
fun display_password_callback(prompt, bullets)
{
  global.password_shown = 1;

  # Hide the progress bar and pause the fake timer while waiting for input
  hide_progress_bar();
  stop_fake_progress();

  show_password_dialog();

  # Clear old bullets
  for (index = 0; global.bullets[index]; index++)
  {
    global.bullets[index].SetOpacity(0);
  }

  # Max bullets that fit inside the entry box (16px padding each side,
  # 9px bullet, 14px pitch)
  max_bullets = Math.Int((entry.image.GetWidth() - 27) / 14);
  if (max_bullets < 1) max_bullets = 1;

  bullets_to_show = bullets;
  if (bullets_to_show > max_bullets)
  {
    bullets_to_show = max_bullets;
  }
  for (index = 0; index < bullets_to_show; index++)
  {
    if (!global.bullets[index])
    {
      global.bullets[index] = Sprite(bullet.image.Scale(9, 9));
      position_bullet(index);
    }
    global.bullets[index].SetOpacity(1);
  }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

#----------------------------------------- Real Progress Callback --------------------------------

fun progress_callback(duration, progress)
{
  # update_progress_bar is monotonic, so real progress simply wins
  # whenever it is ahead of the simulated bar.
  update_progress_bar(progress);
}

Plymouth.SetBootProgressFunction(progress_callback);

#----------------------------------------- Message --------------------------------

message_sprite = Sprite();
message_sprite.SetPosition(0, 0, 2);

fun display_message_callback(text)
{
  img = Image.Text(text, 1, 1, 1);
  message_sprite.SetImage(img);
  message_sprite.SetOpacity(0.9);
  message_sprite.SetX((Window.GetWidth() - img.GetWidth()) / 2);
  message_sprite.SetY(Window.GetHeight() - img.GetHeight() - 12);
}

fun hide_message_callback(text)
{
  message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

#----------------------------------------- Init --------------------------------

layout();