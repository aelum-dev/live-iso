#
# Build hook for the "aelum-live" runtime hook. Keep it after "plymouth" in
# HOOKS: the runtime hook only talks to an already-started plymouthd.

build() {
    add_runscript
}

help() {
    cat <<HELPEOF
This hook pushes live-ISO boot milestones (ISO device found, squashfs mounted,
live root mounted, switch root) to Plymouth, so Aelum's boot splash bar follows
real progress instead of a stand-in timer. Needs "plymouth" in HOOKS.
HELPEOF
}

