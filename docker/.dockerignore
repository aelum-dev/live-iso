# Docker ignore for AestheticOS build
# Exclude large/irrelevant directories from docker context

# Build artifacts (they're in volumes, not needed in context)
downloads/
output/
work/
airootfs/var/

# Git
.git/
.gitignore

# VM artifacts
vdisk.qcow2
OVMF_VARS.fd

# Run script (not needed in container)
run.sh
